{
  "appId": "com.wemd.app",
  "productName": "WeMD",
  "directories": {
    "output": "release"
  },
  "publish": {
    "provider": "github",
    "owner": "ldlkuz",
    "repo": "gzh-wemd"
  },
  "files": [
    "dist/**/*",
    "assets/**/*",
    "package.json",
    "!**/.DS_Store",
    {
      "from": "../../node_modules",
      "to": "node_modules",
      "filter": [
        "electron-updater/**",
        "fs-extra/**",
        "builder-util-runtime/**",
        "js-yaml/**",
        "lazy-val/**",
        "lodash.escaperegexp/**",
        "lodash.isequal/**",
        "semver/**",
        "tiny-typed-emitter/**",
        "jsonfile/**",
        "universalify/**",
        "graceful-fs/**",
        "argparse/**",
        "sprintf-js/**"
      ]
    }
  ],
  "extraResources": [
    {
      "from": "../web/dist",
      "to": "web-dist",
      "filter": ["**/*", "!**/.DS_Store"]
    },
    {
      "from": "../../wechat-plugin",
      "to": "wechat-plugin",
      "filter": ["**/*", "!**/.DS_Store"]
    }
  ],
  "electronLanguages": ["zh-CN", "en-US"],
  "mac": {
    "category": "public.app-category.productivity",
    "target": ["zip"],
    "icon": "assets/icon.icns"
  },
  "win": {
    "target": ["nsis", "zip"],
    "icon": "assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "differentialPackage": false
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Office",
    "icon": "assets/icon.png",
    "maintainer": "WeMD Team"
  }
}
