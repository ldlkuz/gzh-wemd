{
  "$schema": "SkeletonIntentState",
  "description": "Stage 4.5 输出：组件骨架意图状态。骨架 = 一棵空间树，group 为核心结构单元。AI 只描述视觉构图，不写 HTML/CSS/任何 CSS 值。",
  "type": "object",
  "required": ["schema", "skeletons"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "SkeletonIntent"
    },
    "note": {
      "type": "string",
      "description": "说明：允许任意组件提供骨架，未提供/非法则回退全局默认骨架"
    },
    "skeletons": {
      "type": "object",
      "description": "组件骨架 Map，key 为组件 id。仅收录有刻意构图理由的组件，无理由不产出。",
      "additionalProperties": {
        "$ref": "#/definitions/componentSkeleton"
      }
    }
  },
  "definitions": {
    "componentSkeleton": {
      "type": "object",
      "required": ["component", "layout", "regions"],
      "properties": {
        "component": {
          "type": "string",
          "description": "组件 id，必须存在于组件注册表"
        },
        "layout": {
          "$ref": "#/definitions/layout"
        },
        "regions": {
          "type": "array",
          "description": "根容器的直接子区域，顺序即渲染顺序",
          "items": {
            "$ref": "#/definitions/region"
          }
        }
      }
    },
    "layout": {
      "type": "string",
      "description": "容器级：描述父容器内部如何组织直接孩子",
      "enum": ["stack", "centered", "side-rail", "split", "grid", "media-text"]
    },
    "region": {
      "type": "object",
      "description": "视觉角色区域",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["slot", "group", "decoration", "label", "rule"]
        },
        "slot": {
          "type": "string",
          "description": "type=slot 时必填，引用该组件已注册的 slot key（契约固定）"
        },
        "name": {
          "type": "string",
          "description": "type=group/label 时必填：group 为语义边界名；label 引用预定义集"
        },
        "layout": {
          "$ref": "#/definitions/layout",
          "description": "type=group 时可选：该 group 内部如何组织孩子"
        },
        "regions": {
          "type": "array",
          "description": "type=group 时必填：该 group 内的子区域（嵌套深度 ≤ 2 层，由 Validator 校验）",
          "items": {
            "$ref": "#/definitions/region"
          }
        },
        "text": {
          "type": "string",
          "description": "type=label 时可选：静态装饰文案"
        },
        "relation": {
          "type": "string",
          "description": "与相邻区域的关系",
          "enum": ["stack", "inline", "overlay"],
          "default": "stack"
        },
        "align": {
          "type": "string",
          "description": "构图对齐关系（非样式）",
          "enum": ["left", "center", "right"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "slot" } } },
          "then": { "required": ["slot"] }
        },
        {
          "if": { "properties": { "type": { "const": "group" } } },
          "then": { "required": ["name", "regions"] }
        },
        {
          "if": { "properties": { "type": { "const": "label" } } },
          "then": { "required": ["name"] }
        },
        {
          "if": { "properties": { "type": { "const": "decoration" } } },
          "then": { "required": ["name"] }
        }
      ]
    }
  }
}
