{
  "$schema": "BrandVisualTheme",
  "description": "最终主题规范：由 6 个 State（brand/concept/visual_language/component_strategy/skeleton_intent/component_mapping）+ Assembler 注入字段（design_tokens/metadata/schema）合并而成。",
  "type": "object",
  "required": [
    "schema",
    "brand",
    "concept",
    "visual_language",
    "component_strategy",
    "components",
    "skeletons",
    "design_tokens",
    "metadata"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "BrandVisualTheme"
    },
    "brand": {
      "type": "object",
      "description": "来自 themes/{theme-name}/states/brand_state.json",
      "required": ["brand_identity"],
      "properties": {
        "brand_identity": {
          "type": "object",
          "required": ["name", "type"],
          "properties": {
            "name": { "type": "string" },
            "type": {
              "type": "string",
              "enum": [
                "enterprise",
                "creator",
                "media",
                "product",
                "institution",
                "community"
              ]
            }
          }
        },
        "personality": { "type": "array", "items": { "type": "string" } },
        "audience": { "type": "array", "items": { "type": "string" } },
        "emotion": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "industry": { "type": "string" },
        "customer": { "type": "string" },
        "product": { "type": "string" },
        "desired_impression": {
          "type": "array",
          "items": { "type": "string" }
        },
        "existing_assets": { "type": "object" }
      }
    },
    "concept": {
      "type": "object",
      "description": "来自 themes/{theme-name}/states/concept_state.json（用户已选定视觉母题）",
      "required": ["concept_name", "core_concept"],
      "properties": {
        "concept_name": { "type": "string" },
        "core_concept": { "type": "string" },
        "visual_keywords": { "type": "array", "items": { "type": "string" } },
        "emotional_direction": {
          "type": "object",
          "properties": {
            "primary": { "type": "string" },
            "secondary": { "type": "string" }
          }
        },
        "visual_metaphor": {
          "type": "object",
          "description": "用户从 3 个候选中选定的视觉母题",
          "properties": {
            "metaphor_name": { "type": "string" },
            "visual_objects": {
              "type": "array",
              "items": { "type": "string" }
            },
            "material_language": {
              "type": "array",
              "items": { "type": "string" }
            },
            "motion_character": { "type": "string" }
          }
        }
      }
    },
    "visual_language": {
      "type": "object",
      "description": "来自 themes/{theme-name}/states/visual_language.json",
      "required": ["color_direction", "typography", "layout", "shape", "image"],
      "properties": {
        "color_direction": {
          "type": "object",
          "properties": {
            "contrast": {
              "type": "string",
              "enum": ["soft", "normal", "high", "extreme"]
            },
            "character": { "type": "string" },
            "usage": { "type": "string" }
          }
        },
        "typography": {
          "type": "object",
          "properties": {
            "character": { "type": "string" },
            "hierarchy": { "type": "string" }
          }
        },
        "layout": {
          "type": "object",
          "properties": {
            "composition": { "type": "string" },
            "alignment": { "type": "string" },
            "density": {
              "type": "string",
              "enum": ["compact", "normal", "spacious"]
            }
          }
        },
        "shape": {
          "type": "object",
          "properties": {
            "character": { "type": "string" }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "style": { "type": "string" },
            "treatment": { "type": "string" }
          }
        }
      }
    },
    "component_strategy": {
      "type": "object",
      "description": "来自 themes/{theme-name}/states/component_strategy.json",
      "required": ["brand_anchor", "content", "utility"],
      "properties": {
        "brand_anchor": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["component", "score", "reason"],
            "properties": {
              "component": { "type": "string" },
              "score": { "type": "integer", "minimum": 0, "maximum": 10 },
              "reason": { "type": "string" }
            }
          }
        },
        "content": { "type": "array", "items": { "type": "string" } },
        "utility": { "type": "array", "items": { "type": "string" } }
      }
    },
    "components": {
      "type": "object",
      "description": "来自 themes/{theme-name}/states/component_mapping.json（皮）",
      "required": ["focal", "content", "utility"],
      "properties": {
        "focal": {
          "type": "object",
          "description": "key 为组件 id（深度设计焦点集）",
          "additionalProperties": {
            "type": "object",
            "required": ["design"],
            "properties": {
              "design": {
                "type": "object",
                "required": ["role", "direction", "character"],
                "properties": {
                  "role": { "type": "string" },
                  "direction": { "type": "string" },
                  "character": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "content": {
          "type": "object",
          "required": ["inherit", "strategy", "component_rules"],
          "properties": {
            "inherit": { "type": "string", "const": "visual_language" },
            "strategy": { "type": "object" },
            "component_rules": { "type": "object" }
          }
        },
        "utility": {
          "type": "object",
          "required": ["inherit", "strategy", "component_rules"],
          "properties": {
            "inherit": { "type": "string", "const": "visual_language" },
            "strategy": { "type": "object" },
            "component_rules": { "type": "object" }
          }
        }
      }
    },
    "skeletons": {
      "type": "object",
      "description": "来自 themes/{theme-name}/states/skeleton_intent.json（形）。key 为组件 id，仅收录有刻意构图理由的组件。",
      "additionalProperties": {
        "type": "object",
        "required": ["component", "layout", "regions"],
        "properties": {
          "component": { "type": "string" },
          "layout": {
            "type": "string",
            "enum": [
              "stack",
              "centered",
              "side-rail",
              "split",
              "grid",
              "media-text"
            ]
          },
          "regions": { "type": "array" }
        }
      }
    },
    "design_tokens": {
      "type": "object",
      "description": "跨阶段受控词汇表，由 Assembler 从 component_mapping 提取",
      "properties": {
        "emphasis": { "type": "object" },
        "density": { "type": "array", "items": { "type": "string" } },
        "decoration": { "type": "array", "items": { "type": "string" } },
        "contrast": { "type": "array", "items": { "type": "string" } }
      }
    },
    "metadata": {
      "type": "object",
      "description": "由 Assembler 注入",
      "required": ["version"],
      "properties": {
        "version": { "type": "string" }
      }
    }
  }
}
