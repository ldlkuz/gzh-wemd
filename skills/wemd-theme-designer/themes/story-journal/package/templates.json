  "related-posts": "<section class=\"wemd-component wemd-related-posts\" data-component=\"related-posts\">\n<div class=\"wemd-rp-items\">\n{{#each items}}\n<div class=\"wemd-rp-items-item\">\n<div class=\"wemd-rp-items-body\">{{this.body}}</div>\n</div>\n{{/each}}\n</div>\n</section>",
