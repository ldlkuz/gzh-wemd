{
  "magazine-cover": "<section class=\"wemd-component wemd-magazine-cover\" data-component=\"magazine-cover\">\n<section class=\"wemd-mc-title\">{{slot:title}}</section>\n<section class=\"wemd-mc-subtitle\">{{slot:subtitle}}</section>\n<section class=\"wemd-mc-divider\">{{slot:divider}}</section>\n<section class=\"wemd-mc-desc\">{{slot:desc}}</section>\n</section>",
  "section-divider": "<section class=\"wemd-component wemd-section-divider\" data-component=\"section-divider\">\n<section class=\"wemd-sd-part\">{{slot:part}}</section>\n<section class=\"wemd-sd-title\">{{slot:title}}</section>\n</section>",
  "two-column-cards": "<section class=\"wemd-component wemd-two-column-cards\" data-component=\"two-column-cards\">\n<section class=\"wemd-tcc-wrapper\">\n{{#each items}}\n<section class=\"wemd-tcc-item\">\n<section class=\"wemd-tcc-icon\">{{this.icon}}</section>\n<section class=\"wemd-tcc-title\">{{this.title}}</section>\n<section class=\"wemd-tcc-desc\">{{this.desc}}</section>\n</section>\n{{/each}}\n</section>\n</section>",
  "full-quote": "<section class=\"wemd-component wemd-full-quote\" data-component=\"full-quote\">\n<section class=\"wemd-fq-text\">{{slot:text}}</section>\n</section>",
  "image-card": "<section class=\"wemd-component wemd-image-card\" data-component=\"image-card\">\n<section class=\"wemd-ic-image\">{{slot:image}}</section>\n<section class=\"wemd-ic-caption\">{{slot:caption}}</section>\n</section>",
  "end-card": "<section class=\"wemd-component wemd-end-card\" data-component=\"end-card\">\n{{#if title}}<section class=\"wemd-ec-title\">{{slot:title}}</section>{{/if}}\n{{#if subtitle}}<section class=\"wemd-ec-subtitle\">{{slot:subtitle}}</section>{{/if}}\n{{#if deco}}<section class=\"wemd-ec-deco\">{{slot:deco}}</section>{{/if}}\n</section>",
  "text-card": "<section class=\"wemd-component wemd-text-card\" data-component=\"text-card\">\n<div class=\"wemd-component-body\">{{slot:body}}</div>\n</section>",
  "quote-card": "<section class=\"wemd-component wemd-quote-card\" data-component=\"quote-card\">\n<section class=\"wemd-qc-quote\">{{slot:quote}}</section>\n{{#if author}}<section class=\"wemd-qc-author\">{{slot:author}}</section>{{/if}}\n</section>",
  "divider-fancy": "<section class=\"wemd-component wemd-divider-fancy\" data-component=\"divider-fancy\">\n<section class=\"wemd-df-label\">\n{{#if label}}\n<span class=\"wemd-df-line wemd-df-line-left\"></span>\n<span class=\"wemd-df-text\">{{slot:label}}</span>\n<span class=\"wemd-df-line wemd-df-line-right\"></span>\n{{else}}\n<span class=\"wemd-df-dots\">· · ·</span>\n{{/if}}\n</section>\n</section>",
  "cta-card": "<section class=\"wemd-component wemd-cta-card\" data-component=\"cta-card\">\n{{#if title}}<section class=\"wemd-cta-title\">{{slot:title}}</section>{{/if}}\n{{#if body}}<section class=\"wemd-cta-body\">{{slot:body}}</section>{{/if}}\n{{#if action}}<section class=\"wemd-cta-action\">{{slot:action}}</section>{{/if}}\n</section>",
  "code-frame": "<section class=\"wemd-component wemd-code-frame\" data-component=\"code-frame\">\n{{#if title}}<div class=\"wemd-cf-title\">{{slot:title}}</div>{{/if}}\n{{#if code}}<div class=\"wemd-cf-code\">{{slot:code}}</div>{{/if}}\n</section>",
  "callout-pro": "<section class=\"wemd-component wemd-callout-pro\" data-component=\"callout-pro\">\n<div class=\"wemd-component-body\">{{slot:body}}</div>\n</section>",
  "stats-block": "<section class=\"wemd-component wemd-stats-block\" data-component=\"stats-block\">\n<div class=\"wemd-sb-title\">{{slot:title}}</div>\n<div class=\"wemd-sb-items\">\n{{#each items}}\n<div class=\"wemd-sb-items-item\">\n<div class=\"wemd-sb-items-value\">{{this.value}}</div>\n<div class=\"wemd-sb-items-label\">{{this.label}}</div>\n</div>\n{{/each}}\n</div>\n</section>",
  "image-grid": "<section class=\"wemd-component wemd-image-grid\" data-component=\"image-grid\">\n<div class=\"wemd-component-body\">{{slot:body}}</div>\n</section>",
  "author-card": "<section class=\"wemd-component wemd-author-card\" data-component=\"author-card\">\n<div class=\"wemd-component-body\">{{slot:body}}</div>\n</section>",
  "timeline": "<section class=\"wemd-component wemd-timeline\" data-component=\"timeline\">\n{{#if title}}<section class=\"wemd-tl-title\">{{slot:title}}</section>{{/if}}\n{{#if items}}<section class=\"wemd-tl-events\">\n{{#each items}}\n<section class=\"wemd-tl-item\"><span class=\"wemd-tl-dot\"></span><span class=\"wemd-tl-text\">{{this.body}}</span></section>\n{{/each}}\n</section>{{/if}}\n</section>",
