{
  "magazine-cover": "<section class=\"wemd-component wemd-magazine-cover wemd-mc-stack\" data-component=\"magazine-cover\">\n<section class=\"wemd-mc-header wemd-mc-stack\">\n<span class=\"wemd-mc-top-bar\"></span>\n<section class=\"wemd-mc-title\">{{slot:title}}</section>\n</section>\n<section class=\"wemd-mc-subtitle\">{{slot:subtitle}}</section>\n<section class=\"wemd-mc-divider\">{{slot:divider}}</section>\n<section class=\"wemd-mc-main wemd-mc-centered\">\n<section class=\"wemd-mc-desc\">{{slot:desc}}</section>\n</section>\n</section>",
  "brand-sign": "<section class=\"wemd-component wemd-brand-sign wemd-bs-stack\" data-component=\"brand-sign\">\n<span class=\"wemd-bs-top-bar\"></span>\n<section class=\"wemd-bs-brandName\">{{slot:brandName}}</section>\n<section class=\"wemd-bs-tagline\">{{slot:tagline}}</section>\n<section class=\"wemd-bs-slogan\">{{slot:slogan}}</section>\n<section class=\"wemd-bs-divider\">{{slot:divider}}</section>\n<section class=\"wemd-bs-subText\">{{slot:subText}}</section>\n</section>",
  "section-title": "<section class=\"wemd-component wemd-section-title wemd-st-stack\" data-component=\"section-title\">\n<span class=\"wemd-st-top-bar\"></span>\n<div class=\"wemd-component-body\">{{slot:body}}</div>\n</section>",
  "numbered-heading": "<section class=\"wemd-component wemd-numbered-heading wemd-nh-stack\" data-component=\"numbered-heading\">\n<section class=\"wemd-nh-main wemd-nh-side-rail\">\n<span class=\"wemd-nh-dot\"></span>\n<div class=\"wemd-component-body\">{{slot:body}}</div>\n</section>\n</section>",
  "resource-list": "<section class=\"wemd-component wemd-resource-list wemd-rl-stack\" data-component=\"resource-list\">\n<section class=\"wemd-rl-header wemd-rl-stack\">\n<span class=\"wemd-rl-top-bar\"></span>\n<section class=\"wemd-rl-title\">{{slot:title}}</section>\n<section class=\"wemd-rl-subtitle\">{{slot:subtitle}}</section>\n</section>\n<section class=\"wemd-rl-items\">\n{{#each items}}\n<div class=\"wemd-rl-items-item\">\n<div class=\"wemd-rl-items-label\">{{this.label}}</div>\n<div class=\"wemd-rl-items-title\">{{this.title}}</div>\n<div class=\"wemd-rl-items-desc\">{{this.desc}}</div>\n<div class=\"wemd-rl-items-meta\">{{this.meta}}</div>\n<div class=\"wemd-rl-items-tag\">{{this.tag}}</div>\n</div>\n{{/each}}\n</section>\n</section>",
  "styled-table": "<section class=\"wemd-component wemd-styled-table wemd-sbt-stack\" data-component=\"styled-table\">\n<span class=\"wemd-sbt-top-bar\"></span>\n<section class=\"wemd-sbt-table\">{{slot:table}}</section>\n</section>"
}
