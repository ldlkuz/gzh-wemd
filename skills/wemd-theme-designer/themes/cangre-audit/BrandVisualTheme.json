{
  "schema": "BrandVisualTheme",

  "brand": {
    "brand_identity": { "name": "苍洱财税", "type": "enterprise" },
    "industry": "财税服务 · 研发费用加计扣除专项",
    "customer": "科技型中小企业（需做研发费加计扣除申报与备查资料的企业）",
    "product": "研发费用加计扣除合规服务、备查资料整理、税务核查应对",
    "desired_impression": ["行业专家", "可信赖的合规伙伴", "严谨的守护者"],
    "existing_assets": {
      "logo_available": false,
      "geometry": "geometric",
      "line_character": "straight",
      "tone": "neutral",
      "material_feel": "paper"
    },
    "personality": ["meticulous", "reliable", "precise"],
    "audience": [
      "finance managers",
      "tax accountants",
      "tech-company founders"
    ],
    "emotion": ["reassuring", "orderly", "trustworthy"],
    "avoid": ["internet startup style", "too flashy", "cyberpunk"],
    "keywords": ["严谨", "合规", "可信", "条理", "守护"]
  },

  "concept": {
    "concept_name": "税务核查档案室",
    "core_concept": "以'归档、核查、留痕'的档案管理气质，把专业的财税合规服务具象为一份份经得起查验的纸质档案，传递严谨与可信。",
    "visual_keywords": [
      "红头文件",
      "牛皮纸",
      "档案袋",
      "核查清单",
      "骑缝章",
      "归档编号",
      "印章红"
    ],
    "emotional_direction": {
      "primary": "reassuring",
      "secondary": "orderly"
    },
    "visual_metaphor": {
      "metaphor_name": "税务局核查档案袋",
      "visual_objects": [
        "红头文件",
        "牛皮纸档案袋",
        "核查清单",
        "骑缝章",
        "归档编号标签"
      ],
      "material_language": ["牛皮纸", "红色印章油墨", "盖胶印泥", "公文纸"],
      "motion_character": "calm solid"
    }
  },

  "visual_language": {
    "color_direction": {
      "contrast": "high",
      "character": "warm",
      "usage": "accent_driven"
    },
    "typography": { "character": "serif-tape", "hierarchy": "strong" },
    "layout": {
      "composition": "grid",
      "alignment": "strict",
      "density": "normal"
    },
    "shape": { "character": "sharp" },
    "image": { "style": "documentary", "treatment": "natural" }
  },

  "component_strategy": {
    "brand_anchor": [
      {
        "component": "magazine-cover",
        "score": 10,
        "reason": "档案袋封面，第一视觉印象。牛皮纸档案袋面 + 红头文件版式，最直接承载'核查档案'母题，材料语言来自概念母题 material_language['牛皮纸','公文纸']。"
      },
      {
        "component": "brand-sign",
        "score": 9,
        "reason": "红头单位落款签名。'红头文件'的视觉对象对应品牌签名区，desired_impression['可信赖的合规伙伴'] 由此强化认知。"
      },
      {
        "component": "section-title",
        "score": 9,
        "reason": "红头文件式标题。一行红头 + 标题，是税务公文最典型的视觉符号，visual_objects['红头文件'] 直接牵引。"
      },
      {
        "component": "numbered-heading",
        "score": 8,
        "reason": "归档编号标题。visual_objects['归档编号标签'] 牵引，编号感强化'留痕可溯'的条理秩序。"
      },
      {
        "component": "resource-list",
        "score": 8,
        "reason": "核查清单。visual_objects['核查清单'] 直接对应，是研发费备查资料清单的核心表达，editorial 能力契合。"
      },
      {
        "component": "styled-table",
        "score": 8,
        "reason": "核查明细表。visual_capability['authority'] 契合税务核查的权威秩序，承载费用归集明细数据。"
      }
    ],
    "content": [
      "hero-banner",
      "quote-card",
      "full-quote",
      "stats-block",
      "callout-pro",
      "product-card",
      "cta-card",
      "author-card",
      "image-card",
      "image-text-row",
      "image-grid",
      "image-compare",
      "text-card",
      "image-caption",
      "two-column-cards",
      "timeline",
      "table",
      "steps",
      "faq",
      "accordion",
      "toc-nav",
      "series-nav",
      "related-posts",
      "code-frame",
      "code-block",
      "pullquote",
      "share-card",
      "qr-card",
      "follow-bar",
      "tag-label",
      "divider-fancy",
      "testimonial-card",
      "end-card"
    ],
    "utility": [
      "divider",
      "article-section",
      "copyright-notice",
      "section-divider"
    ]
  },

  "components": {
    "focal": {
      "magazine-cover": {
        "design": {
          "role": "文章第一视觉印象：一张待核查的牛皮纸档案袋封面",
          "direction": "顶部窄红头条压住 档案袋 牛皮纸底色，标题如红头文件大字立在上方，副题与分隔线下沉，主体描述居中，四角保留归档角标——为档案袋的 header 红头条、centered 主区与 corner 角标上色。",
          "character": ["warm", "paper", "sharp", "official"]
        }
      },
      "brand-sign": {
        "design": {
          "role": "红头单位式落款签名，强化合规可信的认知",
          "direction": "红头条定位品牌名，签名区用结实的印章感字重与分隔线区隔 slogan/subText，形成公章落款气质——为 brand-sign 的 top-bar 与 divider 上色。",
          "character": ["official", "solid", "trusted", "ordered"]
        }
      },
      "section-title": {
        "design": {
          "role": "章节标题＝一份红头文件，建立正文层级",
          "direction": "每章标题前一条醒目的红头短条，标题用庄重的衬线感大字号，正文承接其下——为 section-title 的 top-bar + body 上色。",
          "character": ["official", "hierarchical", "sharp"]
        }
      },
      "numbered-heading": {
        "design": {
          "role": "归档编号式的小标题，强化条目秩序",
          "direction": "侧栏以印章红点作编号锚点，标题随其右侧排布，形成归档条目质感——为 numbered-heading 的 side-rail 与 dot 上色。",
          "character": ["ordered", "indexed", "precise"]
        }
      },
      "resource-list": {
        "design": {
          "role": "备查资料核查清单，逐项可勾验",
          "direction": "清单头部红头条 + 标题 + 副题，条目以牛皮纸底与细分隔线逐项排布，项前以印章红点作核查记号——为 resource-list 的 header stack 与 items 上色。",
          "character": ["checkable", "ordered", "paper"]
        }
      },
      "styled-table": {
        "design": {
          "role": "研发费归集明细表，权威的数据呈现",
          "direction": "表头上方红头条，表格用细线表框与斑马牛皮纸底，表头与关键数字用印章红强调——为 styled-table 的 top-bar + table 上色。",
          "character": ["authoritative", "tabular", "precise"]
        }
      }
    },
    "content": {
      "inherit": "visual_language",
      "strategy": {
        "expression": "low",
        "readability": "high",
        "decoration": "restrained"
      },
      "component_rules": {
        "text-card": {
          "category": "content",
          "inherit": "visual_language",
          "override": { "emphasis": "low", "decoration": "none" }
        },
        "quote-card": {
          "category": "content",
          "inherit": "visual_language",
          "override": { "emphasis": "medium", "decoration": "restrained" }
        },
        "stats-block": {
          "category": "content",
          "inherit": "visual_language",
          "override": { "emphasis": "high", "decoration": "restrained" }
        },
        "image-card": {
          "category": "content",
          "inherit": "visual_language",
          "override": { "emphasis": "medium", "decoration": "restrained" }
        }
      }
    },
    "utility": {
      "inherit": "visual_language",
      "strategy": {
        "expression": "minimal",
        "attention": "low",
        "decoration": "minimal"
      },
      "component_rules": {
        "divider": {
          "category": "utility",
          "inherit": "visual_language",
          "override": { "attention": "minimal" }
        },
        "divider-fancy": {
          "category": "utility",
          "inherit": "visual_language",
          "override": { "attention": "low", "decoration": "minimal" }
        },
        "copyright-notice": {
          "category": "utility",
          "inherit": "visual_language",
          "override": { "attention": "minimal", "decoration": "none" }
        }
      }
    }
  },

