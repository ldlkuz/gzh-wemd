{
  "schema": "SkeletonIntent",
  "note": "允许任意组件提供骨架；未提供/非法则回退全局默认骨架。此处仅收录 6 个 Brand Anchor，均有刻意构图理由。",
  "skeletons": {
    "magazine-cover": {
      "component": "magazine-cover",
      "layout": "stack",
      "regions": [
        {
          "type": "group",
          "name": "header",
          "layout": "stack",
          "regions": [
            { "type": "decoration", "name": "top-bar" },
            { "type": "slot", "slot": "title" }
          ]
        },
        { "type": "slot", "slot": "subtitle" },
        { "type": "slot", "slot": "divider" },
        {
          "type": "group",
          "name": "main",
          "layout": "centered",
          "regions": [{ "type": "slot", "slot": "desc" }]
        }
      ]
    },
    "brand-sign": {
      "component": "brand-sign",
      "layout": "stack",
      "regions": [
        { "type": "decoration", "name": "top-bar" },
        { "type": "slot", "slot": "brandName" },
        { "type": "slot", "slot": "tagline" },
        { "type": "slot", "slot": "slogan" },
        { "type": "slot", "slot": "divider" },
        { "type": "slot", "slot": "subText" }
      ]
    },
    "section-title": {
      "component": "section-title",
      "layout": "stack",
      "regions": [
        { "type": "decoration", "name": "top-bar" },
        { "type": "slot", "slot": "body" }
      ]
    },
    "numbered-heading": {
      "component": "numbered-heading",
      "layout": "stack",
      "regions": [
        {
          "type": "group",
          "name": "main",
          "layout": "side-rail",
          "regions": [
            { "type": "decoration", "name": "dot" },
            { "type": "slot", "slot": "body" }
          ]
        }
      ]
    },
    "resource-list": {
      "component": "resource-list",
      "layout": "stack",
      "regions": [
        {
          "type": "group",
          "name": "header",
          "layout": "stack",
          "regions": [
            { "type": "decoration", "name": "top-bar" },
            { "type": "slot", "slot": "title" },
            { "type": "slot", "slot": "subtitle" }
          ]
        },
        { "type": "slot", "slot": "items" }
      ]
    },
    "styled-table": {
      "component": "styled-table",
      "layout": "stack",
      "regions": [
        { "type": "decoration", "name": "top-bar" },
        { "type": "slot", "slot": "table" }
      ]
    }
  }
}
