{
  "focal": {
    "magazine-cover": {
      "design": {
        "role": "文章第一视觉印象：一张待核查的牛皮纸档案袋封面",
        "direction": "顶部窄红头条压住 档案袋 牛皮纸底色，标题如红头文件大字立在上方，副题与分隔线下沉，主体描述居中，四角保留归档角标——为档案袋的 header 红头条、centered 主区与 corner 角标上色。",
        "character": ["warm", "paper", "sharp", "official"]
      }
    },
    "brand-sign": {
      "design": {
        "role": "红头单位式落款签名，强化合规可信的认知",
        "direction": "红头条定位品牌名，签名区用结实的印章感字重与分隔线区隔 slogan/subText，形成公章落款气质——为 brand-sign 的 top-bar 与 divider 上色。",
        "character": ["official", "solid", "trusted", "ordered"]
      }
    },
    "section-title": {
      "design": {
        "role": "章节标题＝一份红头文件，建立正文层级",
        "direction": "每章标题前一条醒目的红头短条，标题用庄重的衬线感大字号，正文承接其下——为 section-title 的 top-bar + body 上色。",
        "character": ["official", "hierarchical", "sharp"]
      }
    },
    "numbered-heading": {
      "design": {
        "role": "归档编号式的小标题，强化条目秩序",
        "direction": "侧栏以印章红点作编号锚点，标题随其右侧排布，形成归档条目质感——为 numbered-heading 的 side-rail 与 dot 上色。",
        "character": ["ordered", "indexed", "precise"]
      }
    },
    "resource-list": {
      "design": {
        "role": "备查资料核查清单，逐项可勾验",
        "direction": "清单头部红头条 + 标题 + 副题，条目以牛皮纸底与细分隔线逐项排布，项前以印章红点作核查记号——为 resource-list 的 header stack 与 items 上色。",
        "character": ["checkable", "ordered", "paper"]
      }
    },
    "styled-table": {
      "design": {
        "role": "研发费归集明细表，权威的数据呈现",
        "direction": "表头上方红头条，表格用细线表框与斑马牛皮纸底，表头与关键数字用印章红强调——为 styled-table 的 top-bar + table 上色。",
        "character": ["authoritative", "tabular", "precise"]
      }
    }
  },
  "content": {
    "inherit": "visual_language",
    "strategy": {
      "expression": "low",
      "readability": "high",
      "decoration": "restrained"
    },
    "component_rules": {
      "text-card": {
        "category": "content",
        "inherit": "visual_language",
        "override": { "emphasis": "low", "decoration": "none" }
      },
      "quote-card": {
        "category": "content",
        "inherit": "visual_language",
        "override": { "emphasis": "medium", "decoration": "restrained" }
      },
      "stats-block": {
        "category": "content",
        "inherit": "visual_language",
        "override": { "emphasis": "high", "decoration": "restrained" }
      },
      "image-card": {
        "category": "content",
        "inherit": "visual_language",
        "override": { "emphasis": "medium", "decoration": "restrained" }
      }
    }
  },
  "utility": {
    "inherit": "visual_language",
    "strategy": {
      "expression": "minimal",
      "attention": "low",
      "decoration": "minimal"
    },
    "component_rules": {
      "divider": {
        "category": "utility",
        "inherit": "visual_language",
        "override": { "attention": "minimal" }
      },
      "divider-fancy": {
        "category": "utility",
        "inherit": "visual_language",
        "override": { "attention": "low", "decoration": "minimal" }
      },
      "copyright-notice": {
        "category": "utility",
        "inherit": "visual_language",
        "override": { "attention": "minimal", "decoration": "none" }
      }
    }
  }
}
