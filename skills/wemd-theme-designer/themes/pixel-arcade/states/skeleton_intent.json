{
  "schema": "SkeletonIntent",
  "note": "母题「像素匠人的手作工坊」构图焦点：封面、格纸分区标、工具清单、调色板表、精灵网格 + A 类高表现力组件全覆盖。所有骨架仅描述空间结构，不含任何 CSS 值。单 body 槽组件（share-card/callout-pro/image-compare/image-text-row）结构自由度低，主要以装饰承载母题，骨架价值有限。",
  "skeletons": {
    "magazine-cover": {
      "component": "magazine-cover",
      "layout": "centered",
      "regions": [
        {
          "type": "decoration",
          "name": "top-bar",
          "relation": "inline",
          "align": "center"
        },
        { "type": "slot", "slot": "title" },
        { "type": "slot", "slot": "subtitle" },
        { "type": "slot", "slot": "divider" },
        { "type": "slot", "slot": "desc", "align": "center" }
      ]
    },
    "section-title": {
      "component": "section-title",
      "layout": "stack",
      "regions": [
        {
          "type": "group",
          "name": "main",
          "layout": "centered",
          "regions": [{ "type": "slot", "slot": "body" }]
        },
        { "type": "rule" }
      ]
    },
    "resource-list": {
      "component": "resource-list",
      "layout": "stack",
      "regions": [
        {
          "type": "group",
          "name": "header",
          "layout": "stack",
          "regions": [
            { "type": "decoration", "name": "top-bar", "relation": "inline" },
            { "type": "slot", "slot": "title" },
            { "type": "slot", "slot": "subtitle" }
          ]
        },
        { "type": "slot", "slot": "items" }
      ]
    },
    "styled-table": {
      "component": "styled-table",
      "layout": "stack",
      "regions": [
        { "type": "decoration", "name": "top-bar", "relation": "inline" },
        { "type": "slot", "slot": "table" }
      ]
    },
    "image-grid": {
      "component": "image-grid",
      "layout": "grid",
      "regions": [{ "type": "slot", "slot": "body" }]
    },
    "hero-banner": {
      "component": "hero-banner",
      "layout": "stack",
      "regions": [
        { "type": "decoration", "name": "top-bar", "relation": "inline" },
        { "type": "slot", "slot": "image" },
        {
          "type": "group",
          "name": "main",
          "layout": "centered",
          "regions": [
            { "type": "slot", "slot": "title" },
            { "type": "slot", "slot": "subtitle" }
          ]
        }
      ]
    },
    "product-card": {
      "component": "product-card",
      "layout": "stack",
      "regions": [
        { "type": "slot", "slot": "image" },
        {
          "type": "group",
          "name": "header",
          "layout": "stack",
          "regions": [
            { "type": "slot", "slot": "badge" },
            { "type": "slot", "slot": "title" },
            { "type": "slot", "slot": "subtitle" }
          ]
        },
        { "type": "slot", "slot": "description" },
        {
          "type": "group",
          "name": "price-row",
          "layout": "split",
          "regions": [
            { "type": "slot", "slot": "price" },
            { "type": "slot", "slot": "originalPrice" }
          ]
        },
        { "type": "slot", "slot": "button" },
        { "type": "slot", "slot": "tags" }
      ]
    },
    "brand-sign": {
      "component": "brand-sign",
      "layout": "centered",
      "regions": [
        {
          "type": "decoration",
          "name": "top-bar",
          "relation": "inline",
          "align": "center"
        },
        { "type": "slot", "slot": "brandName" },
        { "type": "slot", "slot": "tagline" },
        {
          "type": "group",
          "name": "stamp",
          "layout": "centered",
          "regions": [
            { "type": "slot", "slot": "slogan" },
            { "type": "slot", "slot": "subText" }
          ]
        }
      ]
    },
    "cta-card": {
      "component": "cta-card",
      "layout": "centered",
      "regions": [
        { "type": "slot", "slot": "title" },
        { "type": "slot", "slot": "body" },
        { "type": "slot", "slot": "action" }
      ]
    },
    "quote-card": {
      "component": "quote-card",
      "layout": "stack",
      "regions": [
        {
          "type": "group",
          "name": "main",
          "layout": "side-rail",
          "regions": [
            { "type": "decoration", "name": "corner", "relation": "inline" },
            { "type": "slot", "slot": "quote" }
          ]
        },
        { "type": "slot", "slot": "author" }
      ]
    },
    "testimonial-card": {
      "component": "testimonial-card",
      "layout": "stack",
      "regions": [
        { "type": "decoration", "name": "top-bar", "relation": "inline" },
        { "type": "slot", "slot": "quote" },
        { "type": "slot", "slot": "source" },
        {
          "type": "group",
          "name": "person",
          "layout": "media-text",
          "regions": [
            { "type": "slot", "slot": "avatar" },
            {
              "type": "group",
              "name": "meta",
              "layout": "stack",
              "regions": [
                { "type": "slot", "slot": "name" },
                { "type": "slot", "slot": "title" },
                { "type": "slot", "slot": "company" }
              ]
            }
          ]
        }
      ]
    },
    "full-quote": {
      "component": "full-quote",
      "layout": "centered",
      "regions": [
        { "type": "decoration", "name": "quote-mark", "relation": "overlay" },
        { "type": "slot", "slot": "text" }
      ]
    },
    "end-card": {
      "component": "end-card",
      "layout": "centered",
      "regions": [
        { "type": "slot", "slot": "title" },
        { "type": "slot", "slot": "subtitle" },
        { "type": "slot", "slot": "deco" }
      ]
    },
    "share-card": {
      "component": "share-card",
      "layout": "centered",
      "regions": [
        { "type": "decoration", "name": "corner", "relation": "inline" },
        { "type": "slot", "slot": "body" }
      ]
    },
    "stats-block": {
      "component": "stats-block",
      "layout": "grid",
      "regions": [{ "type": "slot", "slot": "items" }]
    },
    "callout-pro": {
      "component": "callout-pro",
      "layout": "stack",
      "regions": [
        { "type": "decoration", "name": "top-bar", "relation": "inline" },
        { "type": "slot", "slot": "body" }
      ]
    },
    "image-compare": {
      "component": "image-compare",
      "layout": "split",
      "regions": [{ "type": "slot", "slot": "body" }]
    },
    "image-text-row": {
      "component": "image-text-row",
      "layout": "media-text",
      "regions": [{ "type": "slot", "slot": "body" }]
    }
  }
}
