{
  "magazine-cover": "<section class=\"wemd-component wemd-magazine-cover wemd-mc-centered\" data-component=\"magazine-cover\">\n<span class=\"wemd-mc-top-bar\"></span>\n<section class=\"wemd-mc-title\">{{slot:title}}</section>\n<section class=\"wemd-mc-subtitle\">{{slot:subtitle}}</section>\n<section class=\"wemd-mc-divider\">{{slot:divider}}</section>\n<section class=\"wemd-mc-desc\">{{slot:desc}}</section>\n</section>",
  "section-title": "<section class=\"wemd-component wemd-section-title wemd-st-stack\" data-component=\"section-title\">\n<section class=\"wemd-st-main wemd-st-centered\">\n<div class=\"wemd-component-body\">{{slot:body}}</div>\n</section>\n<hr class=\"wemd-st-rule\">\n</section>",
  "resource-list": "<section class=\"wemd-component wemd-resource-list wemd-rl-stack\" data-component=\"resource-list\">\n<section class=\"wemd-rl-header wemd-rl-stack\">\n<span class=\"wemd-rl-top-bar\"></span>\n<section class=\"wemd-rl-title\">{{slot:title}}</section>\n<section class=\"wemd-rl-subtitle\">{{slot:subtitle}}</section>\n</section>\n<section class=\"wemd-rl-items\">\n{{#each items}}\n<div class=\"wemd-rl-items-item\">\n<div class=\"wemd-rl-items-label\">{{this.label}}</div>\n<div class=\"wemd-rl-items-title\">{{this.title}}</div>\n<div class=\"wemd-rl-items-desc\">{{this.desc}}</div>\n<div class=\"wemd-rl-items-meta\">{{this.meta}}</div>\n<div class=\"wemd-rl-items-tag\">{{this.tag}}</div>\n</div>\n{{/each}}\n</section>\n</section>",
  "styled-table": "<section class=\"wemd-component wemd-styled-table wemd-sbt-stack\" data-component=\"styled-table\">\n<span class=\"wemd-sbt-top-bar\"></span>\n<section class=\"wemd-sbt-table\">{{slot:table}}</section>\n</section>",
  "image-grid": "<section class=\"wemd-component wemd-image-grid wemd-ig-grid\" data-component=\"image-grid\">\n<div class=\"wemd-component-body\">{{slot:body}}</div>\n</section>",
  "hero-banner": "<section class=\"wemd-component wemd-hero-banner wemd-hb-stack\" data-component=\"hero-banner\">\n<span class=\"wemd-hb-top-bar\"></span>\n<section class=\"wemd-hb-image\">{{slot:image}}</section>\n<section class=\"wemd-hb-main wemd-hb-centered\">\n<section class=\"wemd-hb-title\">{{slot:title}}</section>\n<section class=\"wemd-hb-subtitle\">{{slot:subtitle}}</section>\n</section>\n</section>",
  "product-card": "<section class=\"wemd-component wemd-product-card wemd-pc-stack\" data-component=\"product-card\">\n<section class=\"wemd-pc-image\">{{slot:image}}</section>\n<section class=\"wemd-pc-header wemd-pc-stack\">\n<section class=\"wemd-pc-badge\">{{slot:badge}}</section>\n<section class=\"wemd-pc-title\">{{slot:title}}</section>\n<section class=\"wemd-pc-subtitle\">{{slot:subtitle}}</section>\n</section>\n<section class=\"wemd-pc-description\">{{slot:description}}</section>\n<section class=\"wemd-pc-price-row wemd-pc-split\">\n<section class=\"wemd-pc-price\">{{slot:price}}</section>\n<section class=\"wemd-pc-originalPrice\">{{slot:originalPrice}}</section>\n</section>\n<section class=\"wemd-pc-button\">{{slot:button}}</section>\n<section class=\"wemd-pc-tags\">\n{{#each tags}}\n<div class=\"wemd-pc-tags-item\">\n<div class=\"wemd-pc-tags-body\">{{this.body}}</div>\n</div>\n{{/each}}\n</section>\n</section>",
  "brand-sign": "<section class=\"wemd-component wemd-brand-sign wemd-bs-centered\" data-component=\"brand-sign\">\n<span class=\"wemd-bs-top-bar\"></span>\n<section class=\"wemd-bs-brandName\">{{slot:brandName}}</section>\n<section class=\"wemd-bs-tagline\">{{slot:tagline}}</section>\n<section class=\"wemd-bs-stamp wemd-bs-centered\">\n<section class=\"wemd-bs-slogan\">{{slot:slogan}}</section>\n<section class=\"wemd-bs-subText\">{{slot:subText}}</section>\n</section>\n</section>",
  "cta-card": "<section class=\"wemd-component wemd-cta-card wemd-cta-centered\" data-component=\"cta-card\">\n<section class=\"wemd-cta-title\">{{slot:title}}</section>\n<div class=\"wemd-component-body\">{{slot:body}}</div>\n<section class=\"wemd-cta-action\">{{slot:action}}</section>\n</section>",
  "quote-card": "<section class=\"wemd-component wemd-quote-card wemd-qc-stack\" data-component=\"quote-card\">\n<section class=\"wemd-qc-main wemd-qc-side-rail\">\n<span class=\"wemd-qc-corner\"></span>\n<section class=\"wemd-qc-quote\">{{slot:quote}}</section>\n</section>\n<section class=\"wemd-qc-author\">{{slot:author}}</section>\n</section>",
  "testimonial-card": "<section class=\"wemd-component wemd-testimonial-card wemd-tcq-stack\" data-component=\"testimonial-card\">\n<span class=\"wemd-tcq-top-bar\"></span>\n<section class=\"wemd-tcq-quote\">{{slot:quote}}</section>\n<section class=\"wemd-tcq-source\">{{slot:source}}</section>\n<section class=\"wemd-tcq-person wemd-tcq-media-text\">\n<section class=\"wemd-tcq-avatar\">{{slot:avatar}}</section>\n<section class=\"wemd-tcq-meta wemd-tcq-stack\">\n<section class=\"wemd-tcq-name\">{{slot:name}}</section>\n<section class=\"wemd-tcq-title\">{{slot:title}}</section>\n<section class=\"wemd-tcq-company\">{{slot:company}}</section>\n</section>\n</section>\n</section>",
