  "callout-pro": "<section class=\"wemd-component wemd-callout-pro wemd-cp-stack\" data-component=\"callout-pro\">\n<span class=\"wemd-cp-top-bar\"></span>\n<div class=\"wemd-component-body\">{{slot:body}}</div>\n</section>",
  "image-compare": "<section class=\"wemd-component wemd-image-compare wemd-icmp-split\" data-component=\"image-compare\">\n<div class=\"wemd-component-body\">{{slot:body}}</div>\n</section>",
  "image-text-row": "<section class=\"wemd-component wemd-image-text-row wemd-itr-media-text\" data-component=\"image-text-row\">\n<div class=\"wemd-component-body\">{{slot:body}}</div>\n</section>",
  "section-divider": "<section class=\"wemd-component wemd-section-divider\" data-component=\"section-divider\">\n<section class=\"wemd-sd-part\">{{slot:part}}</section>\n<section class=\"wemd-sd-title\">{{slot:title}}</section>\n</section>",
  "two-column-cards": "<section class=\"wemd-component wemd-two-column-cards\" data-component=\"two-column-cards\">\n<section class=\"wemd-tcc-wrapper\">\n{{#each items}}\n<section class=\"wemd-tcc-item\">\n<section class=\"wemd-tcc-icon\">{{this.icon}}</section>\n<section class=\"wemd-tcc-title\">{{this.title}}</section>\n<section class=\"wemd-tcc-desc\">{{this.desc}}</section>\n</section>\n{{/each}}\n</section>\n</section>",
  "image-card": "<section class=\"wemd-component wemd-image-card\" data-component=\"image-card\">\n<section class=\"wemd-ic-image\">{{slot:image}}</section>\n<section class=\"wemd-ic-caption\">{{slot:caption}}</section>\n</section>",
  "text-card": "<section class=\"wemd-component wemd-text-card\" data-component=\"text-card\">\n<div class=\"wemd-component-body\">{{slot:body}}</div>\n</section>",
  "divider-fancy": "<section class=\"wemd-component wemd-divider-fancy\" data-component=\"divider-fancy\">\n<section class=\"wemd-df-label\">\n{{#if label}}\n<span class=\"wemd-df-line wemd-df-line-left\"></span>\n<span class=\"wemd-df-text\">{{slot:label}}</span>\n<span class=\"wemd-df-line wemd-df-line-right\"></span>\n{{else}}\n<span class=\"wemd-df-dots\">· · ·</span>\n{{/if}}\n</section>\n</section>",
  "code-frame": "<section class=\"wemd-component wemd-code-frame\" data-component=\"code-frame\">\n{{#if title}}<div class=\"wemd-cf-title\">{{slot:title}}</div>{{/if}}\n{{#if code}}<div class=\"wemd-cf-code\">{{slot:code}}</div>{{/if}}\n</section>",
  "author-card": "<section class=\"wemd-component wemd-author-card\" data-component=\"author-card\">\n<div class=\"wemd-component-body\">{{slot:body}}</div>\n</section>",
