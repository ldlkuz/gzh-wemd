{
  "brand_anchor": {
    "magazine-cover": {
      "design": {
        "role": "全篇第一视觉，建立'电影片场开场'的权威第一印象（母题：场记板开场板）",
        "direction": "哑光黑满幅封面，顶部银幕白小字片场序号+导演提示，超大加粗纯白标题，底部场记板黑白条纹过渡条，复刻'场记板打板'的电影开场仪式感，营造进入镜头的沉浸入口",
        "character": [
          "matte-black",
          "clapperboard-stripes",
          "screen-white",
          "cinematic-opening",
          "authoritative"
        ]
      }
    },
    "hero-banner": {
      "design": {
        "role": "顶部头图，承载'取景框+开场镜头'的首屏冲击（母题：取景框开场镜头）",
        "direction": "深色取景框式构图，四角金属刻度标记模拟取景器，中央主图文，底部反光条+片场号牌标签，复刻'透过取景器看开场画面'的电影级视觉冲击",
        "character": [
          "viewfinder",
          "metallic-frame",
          "cinematic-shot",
          "high-contrast",
          "dramatic"
        ]
      }
    },
    "full-quote": {
      "design": {
        "role": "整行引述，制造'电影句幕/导演台词'的阅读停顿（母题：银幕字幕行）",
        "direction": "银幕白超大引述文字居中，置于哑光黑底带，顶部和专业字幕相同的小字定位，底部细金属线分隔，复刻'银幕上滚动的电影台词'，强化影像叙事节奏",
        "character": [
          "subtitle-line",
          "screen-white",
          "matte-black",
          "cinematic-pause",
          "centered"
        ]
      }
    },
    "quote-card": {
      "design": {
        "role": "拍摄者金句/镜头对白，承载'台词写在片场'的匠人语录（母题：片场导演语录）",
        "direction": "哑光黑卡片+银幕白引述文字，左侧金属反光条竖条，顶部胶片齿孔装饰，复刻'打板前后导演的金句'，营造片场权威原声感",
        "character": [
          "on-set-quote",
          "matte-black",
          "reflective-strip",
          "film-perforation",
          "authoritative"
        ]
      }
    },
    "stats-block": {
      "design": {
        "role": "拍摄参数/器材数据，承载'技术掌控'的数字权威感（母题：相机参数读数）",
        "direction": "深色面板底，数字用银幕白超大加粗体，顶部金属刻度线+片场号牌式标签，复刻'镜头参数/光圈快门读数'的精密技术感，凸显数据背后的专业掌控",
        "character": [
          "technical",
          "camera-parameters",
          "metallic-gauge",
          "numeric",
          "precise"
        ]
      }
    },
    "styled-table": {
      "design": {
        "role": "场次清单/拍摄日程表，承载'片场场记'的专业秩序（母题：场记板日程表）",
        "direction": "哑光黑表头+银幕白表头文字，行间细金属刻度线分隔，表头左侧场记序号标签，复刻'片场场记板上逐场登记'的秩序，凸显拍摄计划的严谨节奏",
        "character": [
          "tabula",
          "shooting-schedule",
          "metallic-grid",
          "ordered",
          "precise"
        ]
      }
    }
  },
